# Generated knowledge-graph and data-pipeline products
# -----------------------------------------------------------------------------
/data/raw/**
/data/processed/**
/data/production/**
/data/interim/**
/data/cache/**

/data/kg/*.pkl
/data/kg/*.pickle
/data/kg/*.gpickle

# Re-include directories so README.md and .gitkeep placeholders can be tracked.
!/data/**/
!/data/**/.gitkeep
!/data/**/README.md

# Lightweight examples and graph metadata are safe to version.
/data/examples/**
!/data/examples/
!/data/examples/**
!/data/kg/graph_stats.json

