/outputs/**
/reports/**
/artifacts/**
/tmp/**
/temp/**
/.cache/**

*.log
*.log.*
*.tmp
*.temp
*.bak
*.old
*.pid
*.pid.lock
*.lock

# Keep directories and explicit placeholders, but ignore generated contents.
!/logs/**/
!/outputs/**/
!/reports/**/
!/artifacts/**/
!/tmp/**/
!/temp/**/
!/**/.gitkeep

# -----------------------------------------------------------------------------
# Runtime Memory and LangGraph state
# -----------------------------------------------------------------------------
# Anchored paths ensure src/kg_rag_agent/memory/ remains tracked.
/memory/**
/memory_store/**
/checkpoints/**
/.langgraph_api/**
/langgraph.db
/langgraph.sqlite
/langgraph.sqlite3

*.memory.json
*.memory.jsonl
memories.json
memories.jsonl
memory.db
memory.sqlite
memory.sqlite3

# The default persistent Memory location is outputs/memory/, already excluded.

